{
  "openapi": "3.1.0",
  "info": {
    "title": "SILT Static Engine (generator)",
    "version": "1.0.0",
    "description": "Read the house rules and the statics Claude wrote that need an image."
  },
  "servers": [
    {
      "url": "https://silt-static-engine.pages.dev"
    }
  ],
  "paths": {
    "/api/rules": {
      "get": {
        "operationId": "getHouseRules",
        "summary": "Read the house rules every SILT static must follow",
        "responses": {
          "200": {
            "description": "The rules",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "rules": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "text": {
                            "type": "string"
                          },
                          "by": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/queue": {
      "get": {
        "operationId": "getQueue",
        "summary": "The ideas waiting for Claude, and the statics Claude wrote that still need their image (need_images: static_id, headline, chatgpt_prompt, funnel, product)",
        "responses": {
          "200": {
            "description": "The queue",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "need_images": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "static_id": {
                            "type": "string"
                          },
                          "idea_id": {
                            "type": "string"
                          },
                          "headline": {
                            "type": "string"
                          },
                          "chatgpt_prompt": {
                            "type": "string"
                          },
                          "funnel": {
                            "type": "string"
                          },
                          "product": {
                            "type": "string"
                          }
                        }
                      }
                    },
                    "house_rules": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
