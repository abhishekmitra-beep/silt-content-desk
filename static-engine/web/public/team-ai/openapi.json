{
  "openapi": "3.1.0",
  "info": {
    "title": "SILT Static Engine",
    "version": "1.0.0",
    "description": "Make SILT Nutrition Meta ad statics and save them to the team's Static Engine."
  },
  "servers": [
    {
      "url": "https://silt-static-engine.pages.dev"
    }
  ],
  "paths": {
    "/api/rules": {
      "get": {
        "operationId": "getHouseRules",
        "summary": "Read the house rules every SILT static must follow",
        "responses": {
          "200": {
            "description": "The rules",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "rules": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "text": {
                            "type": "string"
                          },
                          "by": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/generate": {
      "post": {
        "operationId": "generateStatics",
        "summary": "Turn an idea into finished statics (the site writes them with its own AI and saves them for the team)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [],
                "properties": {
                  "idea": {
                    "type": "string",
                    "description": "The idea, in a sentence"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 30,
                    "default": 6
                  },
                  "funnel": {
                    "type": "string",
                    "enum": [
                      "auto",
                      "TOFU",
                      "MOFU",
                      "BOFU",
                      "RET"
                    ],
                    "default": "auto"
                  },
                  "product": {
                    "type": "string",
                    "enum": [
                      "auto",
                      "mornings",
                      "nights",
                      "combo"
                    ],
                    "default": "auto"
                  },
                  "explore": {
                    "type": "boolean",
                    "description": "true with no idea: the site's AI reads everything already made and explores a new angle"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The statics that were made",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/items": {
      "post": {
        "operationId": "saveStatic",
        "summary": "Save one static you wrote yourself (it goes to the Approval tab)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "kind",
                  "doc"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "static"
                    ]
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "approval"
                    ],
                    "default": "approval"
                  },
                  "doc": {
                    "type": "object",
                    "description": "The static: t (format), funnel, product, concept, slug, optional cta, and the format's text keys (see the GPT instructions)",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/brief": {
      "get": {
        "operationId": "getBrief",
        "summary": "Read what the engine already has (approved, rejected, every line, past ideas, format use) and suggested new angles, so new statics never repeat and explore new ground",
        "responses": {
          "200": {
            "description": "The brief",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": {
                      "type": "integer"
                    },
                    "approved": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "rejected": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "existing": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "ideas": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "least_used_formats": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "most_used_formats": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "women_share": {
                      "type": "string"
                    },
                    "suggested_angles": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "prompt": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
